{
  "name": "medcounsel-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@medcounsel/web",
    "dev:fresh": "npm run dev:clean --workspace=@medcounsel/web",
    "build": "npm run build --workspace=@medcounsel/web",
    "clean": "npm run clean --workspace=@medcounsel/web",
    "db:generate": "npm run generate --workspace=@medcounsel/database",
    "db:migrate": "npm run migrate --workspace=@medcounsel/database",
    "db:seed": "npm run seed --workspace=@medcounsel/database",
    "import:mcc": "npm run import-all --workspace=@medcounsel/data-ingestion",
    "fetch:mcc-2026": "npm run fetch-mcc-2026 --workspace=@medcounsel/data-ingestion",
    "import:mcc-2026": "npm run import-mcc-2026 --workspace=@medcounsel/data-ingestion",
    "backtest:predictions": "npm run backtest-predictions --workspace=@medcounsel/data-ingestion",
    "test:prediction-engine": "npm run test --workspace=@medcounsel/prediction-engine",
    "test:maharashtra-cutoff-sanity": "npm run test:maharashtra-cutoff-sanity --workspace=@medcounsel/data-ingestion",
    "test:ci": "npm run test:prediction-engine && npm run test:maharashtra-cutoff-sanity && npm run test:mah-seat-matrix-compare && npm run lint && npm run build",
    "fetch:mcc": "npm run fetch-mcc --workspace=@medcounsel/data-ingestion",
    "fetch:maharashtra": "npm run fetch-maharashtra --workspace=@medcounsel/data-ingestion",
    "import:maharashtra": "npm run import-maharashtra --workspace=@medcounsel/data-ingestion",
    "import:maharashtra-merit": "npm run import-maharashtra-merit --workspace=@medcounsel/data-ingestion",
    "import:maharashtra-air-sml": "npm run import-maharashtra-air-sml --workspace=@medcounsel/data-ingestion",
    "pipeline:maharashtra-2025": "python3.11 packages/data-ingestion/python/maharashtra/run_pipeline.py --skip-download",
    "import:maharashtra-2025-db": "npm run import:maharashtra-2025-db --workspace=@medcounsel/data-ingestion",
    "validate:maharashtra-2025-db": "npm run validate:maharashtra-2025-db --workspace=@medcounsel/data-ingestion",
    "maharashtra-2025:db": "npm run pipeline:maharashtra-2025 && npm run import:maharashtra-2025-db && npm run validate:maharashtra-2025-db",
    "fetch:seat-matrix": "npm run fetch-seat-matrix --workspace=@medcounsel/data-ingestion",
    "import:neetpg-colleges": "npm run import-neetpg-colleges --workspace=@medcounsel/data-ingestion",
    "import:neetpg-all": "npm run import-neetpg-all --workspace=@medcounsel/data-ingestion",
    "import:mcc-seat-matrix-2026": "DATABASE_URL=file:./packages/database/prisma/prod.db npm run import-mcc-seat-matrix-2026 --workspace=@medcounsel/data-ingestion",
    "import:maharashtra-2026-seat-matrix": "DATABASE_URL=file:./packages/database/prisma/prod.db npm run import:maharashtra-2026-seat-matrix --workspace=@medcounsel/data-ingestion",
    "sync:maharashtra-2026-seat-matrix-sheet": "python3.11 packages/data-ingestion/python/maharashtra/extract_seat_matrix_gsheet.py && npm run import:maharashtra-2026-seat-matrix && npm run report:maharashtra-2026-seat-matrix --workspace=@medcounsel/data-ingestion",
    "test:mah-seat-matrix-compare": "npm run test:mah-seat-matrix-compare --workspace=@medcounsel/data-ingestion",
    "extract:mcc-round2-2026": "python3.11 packages/data-ingestion/python/mcc/extract_round2_vacancies.py",
    "test:mcc-round2": "python3.11 packages/data-ingestion/python/mcc/test_extract_round2.py",
    "audit:mcc-seat-matrix-2026": "DATABASE_URL=file:./packages/database/prisma/prod.db npm run audit-mcc-seat-matrix-2026 --workspace=@medcounsel/data-ingestion",
    "audit:mcc-seat-matrix-by-college": "DATABASE_URL=file:./packages/database/prisma/prod.db npm run audit-mcc-seat-matrix-by-college --workspace=@medcounsel/data-ingestion",
    "import:nmc-seat-matrix-2026": "npm run import-nmc-seat-matrix-2026 --workspace=@medcounsel/data-ingestion",
    "import:fees": "npm run import-fees --workspace=@medcounsel/data-ingestion",
    "db:push": "npm run push --workspace=@medcounsel/database",
    "lint": "npm run lint --workspace=@medcounsel/web"
  },
  "engines": {
    "node": ">=20"
  }
}

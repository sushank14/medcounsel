# Database (PostgreSQL recommended; SQLite works for local dev)
DATABASE_URL="file:./packages/database/prisma/dev.db"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Set AUTH_REQUIRED=true to enforce login (email/password or Google).
# Default: open access — guest user; /admin requires ADMIN role (or ADMIN_DEV_OPEN=true locally only).
# AUTH_REQUIRED=true
# ADMIN_DEV_OPEN=true
# ALLOWED_USERS="user@example.com|Diksha|USER,admin@example.com|Sushank|ADMIN"
# AUTH_DEFAULT_PASSWORD="your-password"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI (Phase 2)
OPENAI_API_KEY=""
